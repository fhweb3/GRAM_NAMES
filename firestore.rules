rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /inventory/{itemId} {
      // Public storefront can read only active inventory. Admins can read archived items too.
      allow read: if isAdmin() || resource.data.archived == false;
      // All writes go through trusted Cloud Functions only.
      allow create, update, delete: if false;
    }

    match /auditLogs/{logId} {
      // Audit logs are accessed only by trusted Admin SDK code.
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
